# ============================================
# GOOGLE MAPS CONFIGURATION
# ============================================
# Get your API key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Geocoding API, Directions API
REACT_APP_GOOGLE_MAPS_API_KEY=your_api_key_here
REACT_APP_GOOGLE_MAPS_VERSION=weekly
REACT_APP_GOOGLE_MAPS_LIBRARIES=places,geometry
REACT_APP_GOOGLE_MAPS_LANGUAGE=en
REACT_APP_GOOGLE_MAPS_REGION=BR

# ============================================
# APPLICATION CONFIGURATION
# ============================================
REACT_APP_APP_NAME=Cinematic App
REACT_APP_APP_VERSION=1.0.0
REACT_APP_API_TIMEOUT=10000
REACT_APP_GEOLOCATION_TIMEOUT=10000
REACT_APP_GEOLOCATION_HIGH_ACCURACY=true

# ============================================
# DESTINATION CONFIGURATION
# ============================================
REACT_APP_DESTINATION_ADDRESS=R. Estados Unidos, 118 - Camocim, CE, 62400-000, Brazil
REACT_APP_DEFAULT_LATITUDE=-2.9014
REACT_APP_DEFAULT_LONGITUDE=-40.8419
REACT_APP_DEFAULT_ZOOM=15

# ============================================
# ROUTING CONFIGURATION
# ============================================
REACT_APP_DEFAULT_TRAVEL_MODE=DRIVING
REACT_APP_ROUTE_AVOID_TOLLS=true
REACT_APP_ROUTE_AVOID_HIGHWAYS=false
REACT_APP_ROUTE_UNIT_SYSTEM=METRIC

# ============================================
# UI CONFIGURATION
# ============================================
REACT_APP_MAP_HEIGHT=500
REACT_APP_MAP_BORDER_RADIUS=8