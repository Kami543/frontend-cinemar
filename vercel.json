{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-cinemar-6.onrender.com/api/v1/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}